APP_NAME=Alodium
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=alodium
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=resend
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=hello@alodium.dev
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

RESEND_API_KEY=

# MaxMind GeoLite2 (country lookups, offline). Only needed to run `php artisan location:update`.
MAXMIND_LICENSE_KEY=

# Astro public site rebuilds. Generate the secret with: openssl rand -hex 32
WEBHOOK_SECRET=
# On the server: /var/www/alodium/rebuild-astro.sh (leave empty locally to skip rebuilds)
ASTRO_REBUILD_SCRIPT=

# Public registration. Defaults to off when APP_ENV=production; set to true/false to override.
# AUTH_REGISTRATION=true

# Sentry error monitoring. Only active when APP_ENV=production; the browser
# uses the same DSN, passed at runtime (no VITE_ variable or rebuild needed).
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Off-server database backups (S3-compatible storage). Leave empty to keep backups local only.
BACKUP_S3_KEY=
BACKUP_S3_SECRET=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_USE_PATH_STYLE=true
# Encrypts backups before upload. Store a copy outside the server: without it, remote backups cannot be restored.
BACKUP_ENCRYPTION_PASSPHRASE=

# Where contact form submissions are emailed. Empty: MAIL_FROM_ADDRESS.
CONTACT_NOTIFY_EMAIL=

# The public (Astro) site, e.g. https://example.com. Shown as "View site" on the dashboard;
# referrers from it are navigation within the site, left out of the analytics' referrers.
PUBLIC_SITE_URL=

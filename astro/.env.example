# Laravel public content API (no trailing slash). Laravel must be running during the build.
API_URL=http://localhost:8000/api/public
# Alodium tracker script, served by Laravel.
TRACKER_URL=http://localhost:8000/tracker.js
# Public URL of this site (sitemap, canonical links).
SITE_URL=http://localhost:4321
# Organisation name in structured data (JSON-LD). Defaults to Alodium.
SITE_NAME=Alodium

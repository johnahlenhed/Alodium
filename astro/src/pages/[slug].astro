---
import BlockRenderer from '../components/blocks/BlockRenderer.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPage, getPages } from '../lib/api.js';
import { firstRenderedBlock } from '../components/blocks/registry.js';
import { absoluteUrl, webPageJsonLd } from '../lib/jsonld.js';

export async function getStaticPaths() {
    // URLs that belong to other routes. A CMS page with one of these slugs would
    // clash with them, so it is left out of the build (with a warning).
    // Declared in here because Astro runs getStaticPaths() in isolation from the
    // rest of the frontmatter.
    const RESERVED = ['blog', 'contact', '404', 'index'];

    const pages = (await getPages()).filter((page) => {
        if (RESERVED.includes(page.slug)) {
            console.warn(`Skipping CMS page "${page.title}": the URL /${page.slug} is already used by the site.`);
            return false;
        }
        return true;
    });

    return Promise.all(
        pages.map(async (summary) => ({
            params: { slug: summary.slug },
            props: { page: await getPage(summary.slug), excerpt: summary.excerpt },
        })),
    );
}

const { page, excerpt } = Astro.props;
const jsonLd = webPageJsonLd({ page, excerpt, url: absoluteUrl(Astro.url.pathname, Astro.site), site: Astro.site });

// Block page (blocks is a list) or legacy page (blocks is null, content is HTML).
const isBlockPage = Array.isArray(page.blocks);
if (isBlockPage && page.blocks.length === 0) {
    console.warn(`[blocks] Page "${page.slug}" is published but has no blocks.`);
}
// A hero as the first rendered block provides the page's <h1>, so the title isn't
// repeated as a second <h1> above it (the title stays in <title> and the metadata).
const heroProvidesHeading = isBlockPage && firstRenderedBlock(page.blocks)?.type === 'hero';
---

<BaseLayout
    title={page.title}
    metaTitle={page.meta_title}
    description={page.meta_description || excerpt}
    ogImage={page.og_image}
    ogImageWidth={page.og_image_width}
    ogImageHeight={page.og_image_height}
    ogType="website"
    jsonLd={jsonLd}
>
    <article>
        {!heroProvidesHeading && <h1>{page.title}</h1>}
        {
            isBlockPage ? (
                <BlockRenderer blocks={page.blocks} slug={page.slug} />
            ) : (
                <div class="prose" set:html={page.content ?? ''} />
            )
        }
    </article>
</BaseLayout>

---
import CmsPage from '../components/CmsPage.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPage, getPages, getSite } from '../lib/api.js';
import { absoluteUrl, webPageJsonLd } from '../lib/jsonld.js';

export async function getStaticPaths() {
    // URLs that belong to other routes. A CMS page with one of these slugs would
    // clash with them, so it is left out of the build (with a warning).
    // Declared in here because Astro runs getStaticPaths() in isolation from the
    // rest of the frontmatter.
    const RESERVED = ['blog', 'contact', '404', 'index'];

    const pages = (await getPages()).filter((page) => {
        if (RESERVED.includes(page.slug)) {
            console.warn(`Skipping CMS page "${page.title}": the URL /${page.slug} is already used by the site.`);
            return false;
        }
        return true;
    });

    return Promise.all(
        pages.map(async (summary) => ({
            params: { slug: summary.slug },
            props: { page: await getPage(summary.slug), excerpt: summary.excerpt },
        })),
    );
}

const { page, excerpt } = Astro.props;
const settings = await getSite();

// The front page is shown at "/". It still builds here (old links keep working),
// but points search engines to "/" and is left out of the sitemap (astro.config.mjs
// skips pages whose canonical link points elsewhere). It gets no WebPage JSON-LD:
// "/" describes the site as a WebSite.
const isFrontPage = settings.frontPage?.slug === page.slug;
const jsonLd = isFrontPage
    ? null
    : webPageJsonLd({ page, excerpt, url: absoluteUrl(Astro.url.pathname, Astro.site), site: Astro.site, siteName: settings.name });
---

<BaseLayout
    title={page.title}
    metaTitle={page.meta_title}
    description={page.meta_description || excerpt}
    ogImage={page.og_image}
    ogImageWidth={page.og_image_width}
    ogImageHeight={page.og_image_height}
    ogType="website"
    jsonLd={jsonLd}
    canonicalPath={isFrontPage ? '/' : undefined}
>
    <CmsPage page={page} />
</BaseLayout>

---
import PostList from '../../components/PostList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts, getSite } from '../../lib/api.js';
import { absoluteUrl, blogJsonLd } from '../../lib/jsonld.js';

const posts = await getPosts();
const settings = await getSite();
const jsonLd = blogJsonLd({ url: absoluteUrl(Astro.url.pathname, Astro.site), site: Astro.site, siteName: settings.name });
---

<BaseLayout title="Blog" jsonLd={jsonLd}>
    <h1>Blog</h1>
    <p class="meta">{posts.length} {posts.length === 1 ? 'post' : 'posts'}</p>
    <PostList posts={posts} />
</BaseLayout>

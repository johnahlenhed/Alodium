---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, getPost, getPosts } from '../../lib/api.js';

// Runs once at build time: one HTML file is generated per published post.
export async function getStaticPaths() {
    const posts = await getPosts();

    return Promise.all(
        posts.map(async (summary) => ({
            params: { slug: summary.slug },
            props: { post: await getPost(summary.slug), excerpt: summary.excerpt },
        })),
    );
}

const { post, excerpt } = Astro.props;
---

<BaseLayout
    title={post.title}
    metaTitle={post.meta_title}
    description={post.meta_description || excerpt}
    ogImage={post.og_image}
    ogImageWidth={post.og_image_width}
    ogImageHeight={post.og_image_height}
    ogType="article"
>
    <article>
        <h1>{post.title}</h1>
        <p class="meta">
            {post.published_at && <time datetime={post.published_at}>{formatDate(post.published_at)}</time>}
            {post.author && <> · {post.author}</>}
        </p>
        {/* Trusted HTML: written in the admin editor or sanitised by the WordPress importer. */}
        <div class="prose" set:html={post.content ?? ''} />
    </article>

    <p><a href="/blog">← Back to blog</a></p>
</BaseLayout>

---
import '../styles/blocks.css';
import '../styles/site.css';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { fontFaceCss, fontPreloadMarkup } from '../lib/fonts.js';
import { serializeJsonLd } from '../lib/jsonld.js';
import { SITE } from '../lib/site.js';
import { buildTheme } from '../lib/theme.js';

interface Props {
    /** Page title; " | <site name>" is appended. */
    title?: string;
    /** SEO title from the CMS; used exactly as written. */
    metaTitle?: string | null;
    description?: string | null;
    ogImage?: string | null;
    /** Only known when the image is the 1200x630 OG conversion picked in the editor. */
    ogImageWidth?: number | null;
    ogImageHeight?: number | null;
    /** "article" for blog posts, "website" for everything else. */
    ogType?: 'article' | 'website';
    /** schema.org structured data for this page (see src/lib/jsonld.js). */
    jsonLd?: Record<string, unknown> | null;
}

const { title, metaTitle, description, ogImage, ogImageWidth, ogImageHeight, ogType = 'website', jsonLd } = Astro.props;

const fullTitle = metaTitle || (title ? `${title} | ${SITE.name}` : SITE.name);
const canonical = new URL(Astro.url.pathname, Astro.site);

// The tracker posts to the Laravel API root (…/api), not the public content API (…/api/public).
const trackerUrl = import.meta.env.TRACKER_URL;
const trackerApi = (import.meta.env.API_URL ?? '').replace(/\/+$/, '').replace(/\/public$/, '');

// The client's theme (colour, fonts, corners, buttons). Until the site settings
// feature passes the settings in, buildTheme() returns the defaults.
// Everything in it comes from allow-lists in src/lib/theme.js and fonts.js, so
// it is safe to write into the page as-is.
const theme = buildTheme();
const themeCss = `${fontFaceCss(theme.fontsToLoad)}\n${theme.css}`;
---

<!doctype html>
<html lang="en" {...theme.htmlAttributes}>
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{fullTitle}</title>
        {description && <meta name="description" content={description} />}
        <link rel="canonical" href={canonical} />
        <!-- Open Graph / social sharing -->
        <meta property="og:site_name" content={SITE.name} />
        <meta property="og:type" content={ogType} />
        <meta property="og:url" content={canonical} />
        <meta property="og:title" content={fullTitle} />
        {description && <meta property="og:description" content={description} />}
        {ogImage && <meta property="og:image" content={ogImage} />}
        {/* Only when the real size is known: wrong dimensions make platforms crop badly. */}
        {ogImage && ogImageWidth && <meta property="og:image:width" content={String(ogImageWidth)} />}
        {ogImage && ogImageHeight && <meta property="og:image:height" content={String(ogImageHeight)} />}
        {/* X reads the twitter:* tags with name=, not property=. A large card needs an image. */}
        <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
        {ogImage && <meta name="twitter:image" content={ogImage} />}
        <link rel="icon" href="/favicon.ico" sizes="32x32" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
        <link rel="sitemap" href="/sitemap-index.xml" />

        {/* Only the font files the theme uses: preloaded, and their @font-face rules. */}
        <Fragment set:html={fontPreloadMarkup(theme.fontsToLoad)} />
        <style is:inline set:html={themeCss}></style>

        {jsonLd && <script type="application/ld+json" is:inline set:html={serializeJsonLd(jsonLd)} />}

        {
            trackerUrl && (
                <>
                    {/* Must run before tracker.js so it knows where to send data. */}
                    <script is:inline define:vars={{ trackerApi }}>
                        window.ALODIUM_TRACKER_URL = trackerApi;
                    </script>
                    <script is:inline src={trackerUrl} defer />
                </>
            )
        }
    </head>
    <body>
        <a class="skip-link" href="#main">Skip to content</a>

        <SiteHeader />

        <main id="main" class="site-main">
            <slot />
        </main>

        <SiteFooter />
    </body>
</html>

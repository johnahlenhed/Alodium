---
interface Props {
    /** Page title; " | Alodium" is appended. */
    title?: string;
    /** SEO title from the CMS; used exactly as written. */
    metaTitle?: string | null;
    description?: string | null;
    ogImage?: string | null;
}

const { title, metaTitle, description, ogImage } = Astro.props;

const fullTitle = metaTitle || (title ? `${title} | Alodium` : 'Alodium');
const canonical = new URL(Astro.url.pathname, Astro.site);

// The tracker posts to the Laravel API root (…/api), not the public content API (…/api/public).
const trackerUrl = import.meta.env.TRACKER_URL;
const trackerApi = (import.meta.env.API_URL ?? '').replace(/\/+$/, '').replace(/\/public$/, '');
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{fullTitle}</title>
        {description && <meta name="description" content={description} />}
        <link rel="canonical" href={canonical} />
        <meta property="og:title" content={fullTitle} />
        {description && <meta property="og:description" content={description} />}
        {ogImage && <meta property="og:image" content={ogImage} />}
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="sitemap" href="/sitemap-index.xml" />

        {
            trackerUrl && (
                <>
                    {/* Must run before tracker.js so it knows where to send data. */}
                    <script is:inline define:vars={{ trackerApi }}>
                        window.ALODIUM_TRACKER_URL = trackerApi;
                    </script>
                    <script is:inline src={trackerUrl} defer />
                </>
            )
        }
    </head>
    <body>
        <header class="site-header">
            <a href="/" class="site-name">Alodium</a>
            <nav aria-label="Main">
                <a href="/">Home</a>
                <a href="/blog">Blog</a>
                <a href="/contact">Contact</a>
            </nav>
        </header>

        <main>
            <slot />
        </main>

        <footer class="site-footer">© {new Date().getFullYear()} Alodium</footer>

        <style is:global>
            *,
            *::before,
            *::after {
                box-sizing: border-box;
            }

            body {
                max-width: 720px;
                margin: 0 auto;
                padding: 0 1rem;
                font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
                line-height: 1.6;
                color: #1f2937;
                background: #fff;
            }

            a {
                color: #2563eb;
            }

            .site-header {
                display: flex;
                flex-wrap: wrap;
                gap: 0.5rem 1rem;
                align-items: baseline;
                justify-content: space-between;
                padding: 1.5rem 0;
                border-bottom: 1px solid #e5e7eb;
            }

            .site-name {
                font-weight: 700;
                color: inherit;
                text-decoration: none;
            }

            .site-header nav {
                display: flex;
                gap: 1rem;
            }

            main {
                padding: 2rem 0;
            }

            .site-footer {
                padding: 2rem 0;
                border-top: 1px solid #e5e7eb;
                color: #6b7280;
                font-size: 0.875rem;
            }

            .meta {
                color: #6b7280;
                font-size: 0.9rem;
            }

            /* Post list */
            .post-list {
                list-style: none;
                padding: 0;
            }

            .post-list li + li {
                margin-top: 2rem;
            }

            .post-list h2 {
                margin: 0 0 0.25rem;
                font-size: 1.25rem;
            }

            .post-list p {
                margin: 0.25rem 0 0;
            }

            /* Content from the CMS (TipTap / WordPress import) */
            .prose h1 { font-size: 2rem; line-height: 1.25; }
            .prose h2 { font-size: 1.5rem; line-height: 1.3; margin-top: 2rem; }
            .prose h3 { font-size: 1.25rem; margin-top: 1.5rem; }
            .prose h4 { font-size: 1.1rem; }
            .prose h5,
            .prose h6 { font-size: 1rem; }
            .prose p { margin: 1rem 0; }
            .prose ul,
            .prose ol { padding-left: 1.5rem; }
            .prose li > p { margin: 0.25rem 0; }
            .prose blockquote {
                margin: 1.5rem 0;
                padding-left: 1rem;
                border-left: 4px solid #d1d5db;
                color: #4b5563;
                font-style: italic;
            }
            .prose code {
                padding: 0.1em 0.35em;
                border-radius: 4px;
                background: #f3f4f6;
                font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
                font-size: 0.9em;
            }
            .prose pre {
                overflow-x: auto;
                padding: 1rem;
                border-radius: 6px;
                background: #f3f4f6;
            }
            .prose pre code {
                padding: 0;
                background: none;
            }
            .prose img {
                max-width: 100%;
                height: auto;
            }
            .prose hr {
                margin: 2rem 0;
                border: 0;
                border-top: 1px solid #e5e7eb;
            }
        </style>
    </body>
</html>

---
import '../styles/blocks.css';
import { serializeJsonLd } from '../lib/jsonld.js';

interface Props {
    /** Page title; " | Alodium" is appended. */
    title?: string;
    /** SEO title from the CMS; used exactly as written. */
    metaTitle?: string | null;
    description?: string | null;
    ogImage?: string | null;
    /** Only known when the image is the 1200x630 OG conversion picked in the editor. */
    ogImageWidth?: number | null;
    ogImageHeight?: number | null;
    /** "article" for blog posts, "website" for everything else. */
    ogType?: 'article' | 'website';
    /** schema.org structured data for this page (see src/lib/jsonld.js). */
    jsonLd?: Record<string, unknown> | null;
}

const { title, metaTitle, description, ogImage, ogImageWidth, ogImageHeight, ogType = 'website', jsonLd } = Astro.props;

const fullTitle = metaTitle || (title ? `${title} | Alodium` : 'Alodium');
const canonical = new URL(Astro.url.pathname, Astro.site);

// The tracker posts to the Laravel API root (…/api), not the public content API (…/api/public).
const trackerUrl = import.meta.env.TRACKER_URL;
const trackerApi = (import.meta.env.API_URL ?? '').replace(/\/+$/, '').replace(/\/public$/, '');
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{fullTitle}</title>
        {description && <meta name="description" content={description} />}
        <link rel="canonical" href={canonical} />
        <!-- Open Graph / social sharing -->
        <meta property="og:site_name" content="Alodium" />
        <meta property="og:type" content={ogType} />
        <meta property="og:url" content={canonical} />
        <meta property="og:title" content={fullTitle} />
        {description && <meta property="og:description" content={description} />}
        {ogImage && <meta property="og:image" content={ogImage} />}
        {/* Only when the real size is known: wrong dimensions make platforms crop badly. */}
        {ogImage && ogImageWidth && <meta property="og:image:width" content={String(ogImageWidth)} />}
        {ogImage && ogImageHeight && <meta property="og:image:height" content={String(ogImageHeight)} />}
        {/* X reads the twitter:* tags with name=, not property=. A large card needs an image. */}
        <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
        {ogImage && <meta name="twitter:image" content={ogImage} />}
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="sitemap" href="/sitemap-index.xml" />

        {jsonLd && <script type="application/ld+json" is:inline set:html={serializeJsonLd(jsonLd)} />}

        {
            trackerUrl && (
                <>
                    {/* Must run before tracker.js so it knows where to send data. */}
                    <script is:inline define:vars={{ trackerApi }}>
                        window.ALODIUM_TRACKER_URL = trackerApi;
                    </script>
                    <script is:inline src={trackerUrl} defer />
                </>
            )
        }
    </head>
    <body>
        <header class="site-header">
            <a href="/" class="site-name">Alodium</a>
            <nav aria-label="Main">
                <a href="/">Home</a>
                <a href="/blog">Blog</a>
                <a href="/contact">Contact</a>
            </nav>
        </header>

        <main>
            <slot />
        </main>

        <footer class="site-footer">© {new Date().getFullYear()} Alodium</footer>

        <style is:global>
            *,
            *::before,
            *::after {
                box-sizing: border-box;
            }

            body {
                max-width: 720px;
                margin: 0 auto;
                padding: 0 1rem;
                font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
                line-height: 1.6;
                color: #1f2937;
                background: #fff;
            }

            a {
                color: #2563eb;
            }

            .site-header {
                display: flex;
                flex-wrap: wrap;
                gap: 0.5rem 1rem;
                align-items: baseline;
                justify-content: space-between;
                padding: 1.5rem 0;
                border-bottom: 1px solid #e5e7eb;
            }

            .site-name {
                font-weight: 700;
                color: inherit;
                text-decoration: none;
            }

            .site-header nav {
                display: flex;
                gap: 1rem;
            }

            main {
                padding: 2rem 0;
            }

            .site-footer {
                padding: 2rem 0;
                border-top: 1px solid #e5e7eb;
                color: #6b7280;
                font-size: 0.875rem;
            }

            .meta {
                color: #6b7280;
                font-size: 0.9rem;
            }

            /* Post list */
            .post-list {
                list-style: none;
                padding: 0;
            }

            .post-list li + li {
                margin-top: 2rem;
            }

            .post-list h2 {
                margin: 0 0 0.25rem;
                font-size: 1.25rem;
            }

            .post-list p {
                margin: 0.25rem 0 0;
            }

        </style>
    </body>
</html>

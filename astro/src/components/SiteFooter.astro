---
import { currentState, SITE } from '../lib/site.js';

const { pathname } = Astro.url;
// The year the site was built (the site is static).
const year = new Date().getFullYear();
---

<footer class="site-footer">
    <div class="site-footer__inner">
        <p class="site-footer__name">© {year} {SITE.name}</p>

        <nav class="site-footer__nav" aria-label="Footer">
            <ul role="list">
                {
                    SITE.navigation.map((item) => (
                        <li>
                            <a href={item.href} aria-current={currentState(item.href, pathname)}>
                                {item.label}
                            </a>
                        </li>
                    ))
                }
            </ul>
        </nav>

        <p class="site-footer__note">{SITE.footerNote}</p>
    </div>
</footer>

---
import { FOOTER_LAYOUTS, layoutClass } from '../lib/layouts.js';
import { currentState } from '../lib/settings.js';

interface Props {
    /** From getSite() (src/lib/api.js). */
    settings: {
        name: string;
        footerText: string | null;
        /** The footer's colour and which text it takes (src/lib/footerBackground.js), or null. */
        footerBackground: { color: string; scheme: 'light' | 'dark' } | null;
        /** How the footer is arranged (src/lib/layouts.js); "standard" adds no class. */
        footerLayout: string;
        /** The published privacy notice, or null (src/lib/settings.js). */
        privacyPage?: { slug: string } | null;
    };
    /** The same navigation as the header. */
    navigation: Array<{ label: string; href: string }>;
}

/**
 * Not a setting: the site always uses the cookie-free tracker. "cookie-free
 * analytics" links to the privacy notice once it is published; until then the
 * sentence is plain text, so the footer never links to a page that isn't there.
 */
const ANALYTICS_NOTE = ['This site uses ', 'cookie-free analytics', '.'];

const { settings, navigation } = Astro.props;
const privacyHref = settings.privacyPage ? `/${settings.privacyPage.slug}` : null;
const { footerBackground, footerLayout } = settings;
const { pathname } = Astro.url;
// The year the site was built (the site is static).
const year = new Date().getFullYear();
---

<footer
    class:list={['site-footer', footerBackground && `site-footer--${footerBackground.scheme}`, layoutClass('site-footer', FOOTER_LAYOUTS, footerLayout)]}
    style={footerBackground ? `--footer-bg: ${footerBackground.color}` : undefined}
>
    <div class="site-footer__inner">
        <p class="site-footer__name">© {year} {settings.name}</p>

        <nav class="site-footer__nav" aria-label="Footer">
            <ul role="list">
                {
                    navigation.map((item) => (
                        <li>
                            <a href={item.href} aria-current={currentState(item.href, pathname)}>
                                {item.label}
                            </a>
                        </li>
                    ))
                }
            </ul>
        </nav>

        {settings.footerText && <p class="site-footer__text">{settings.footerText}</p>}
        <p class="site-footer__note">
            {ANALYTICS_NOTE[0]}{privacyHref ? <a href={privacyHref} aria-current={currentState(privacyHref, pathname)}>{ANALYTICS_NOTE[1]}</a> : ANALYTICS_NOTE[1]}{ANALYTICS_NOTE[2]}
        </p>
    </div>
</footer>
